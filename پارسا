# ------------------------
# جدول‌ها با حذف
# ------------------------
def page_list(path, title, fields):
    data = load(path)
    rows = ""
    for i, d in enumerate(data):
        rows += "<tr>" + "".join(f"<td>{d[f]}</td>" for f in fields)
        rows += f'<td><a class="btn" href="/delete?path={path}&index={i}">حذف</a></td>'
        rows += "</tr>"
    table = f"<table><tr>{''.join(f'<th>{f}</th>' for f in fields)}<th>حذف</th></tr>{rows}</table>"
    return header(title) + f"<h2>{title}</h2>" + table + footer()

# ------------------------
# سرور
# ------------------------
class Server(BaseHTTPRequestHandler):
    def do_GET(self):
        routes = {
            "/": lambda: page_home(),
            "/register": lambda: page_register(),
            "/doctor": lambda: page_doctor(),
            "/lab": lambda: page_lab(),
            "/lab-result": lambda: page_lab_result(),
            "/list": lambda: page_list(DATA_CLINIC, "لیست درمانگاه‌ها", ["clinic", "x", "y"]),
            "/doctor-list": lambda: page_list(DATA_DOCTOR, "لیست پزشکان", ["name", "expert"]),
            "/lab-list": lambda: page_list(DATA_LAB, "لیست آزمایشگاه‌ها", ["name", "service"]),
            "/test-list": lambda: page_list(DATA_TEST, "نتایج آزمایش", ["lab","patient","test_name","result"]),
        }

        if self.path.startswith("/delete"):
            query = urllib.parse.urlparse(self.path).query
            params = urllib.parse.parse_qs(query)
            path_file = params.get("path", [None])[0]
            index = int(params.get("index", [0])[0])
            if path_file and os.path.exists(path_file):
                items = load(path_file)
                if 0 <= index < len(items):
                    items.pop(index)
                    save(path_file, items)
            self.redirect(self.headers.get("Referer", "/"))
            return

        if self.path == "/test.pdf":
            if os.path.exists("test_result.pdf"):
                self.send_response(200)
                self.send_header("Content-type", "application/pdf")
                self.end_headers()
                with open("test_result.pdf", "rb") as f:
                    self.wfile.write(f.read())
                return

        if self.path in routes:
            page = routes[self.path]()
            self.send_response(200)
            self.send_header("Content-type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(page.encode("utf-8"))
        else:
            self.send_error(404)

    def do_POST(self):
        length = int(self.headers['Content-Length'])
        data = urllib.parse.parse_qs(self.rfile.read(length).decode())
        def v(x): return data[x][0]

        if self.path == "/register":
            items = load(DATA_CLINIC)
            items.append({"clinic": v("clinic"), "x": v("x"), "y": v("y")})
            save(DATA_CLINIC, items)

        elif self.path == "/doctor":
            items = load(DATA_DOCTOR)
            items.append({"name": v("name"), "expert": v("expert")})
            save(DATA_DOCTOR, items)

        elif self.path == "/lab":
            items = load(DATA_LAB)
            items.append({"name": v("name"), "service": v("service")})
            save(DATA_LAB, items)

        elif self.path == "/lab-result":
            info = {
                "lab": v("lab"), "patient": v("patient"), "test_name": v("test_name"),
                "result": v("result"), "normal": v("normal"), "comment": v("comment")
            }
            items = load(DATA_TEST)
            items.append(info)
            save(DATA_TEST, items)
            make_test_pdf(info)
            self.redirect("/test.pdf")
            return

        self.redirect("/")

    def redirect(self, url):
        self.send_response(302)
        self.send_header("Location", url)
        self.end_headers()

# ------------------------
# اجرا
# ------------------------
print("Server running at http://localhost:8080")
HTTPServer(("localhost", 8080), Server).serve_forever()

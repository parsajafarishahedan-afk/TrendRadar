from http.server import BaseHTTPRequestHandler, HTTPServer
import urllib.parse
import json
import os
from reportlab.pdfgen import canvas
from reportlab.lib.pagesizes import A4

# ------------------------
# فایل‌های دیتابیس
# ------------------------
DATA_CLINIC = "clinics.json"
DATA_DOCTOR = "doctors.json"
DATA_LAB = "labs.json"
DATA_TEST = "tests.json"

for f in [DATA_CLINIC, DATA_DOCTOR, DATA_LAB, DATA_TEST]:
    if not os.path.exists(f):
        with open(f, "w", encoding="utf-8") as file:
            json.dump([], file, ensure_ascii=False, indent=2)

def load(path):
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)

def save(path, data):
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)

# ------------------------
# PDF نتیجه آزمایش
# ------------------------
def make_test_pdf(info):
    filename = "test_result.pdf"
    c = canvas.Canvas(filename, pagesize=A4)
    c.setFont("Helvetica-Bold", 18)
    c.drawString(100, 800, "Lab Test Report")
    c.setFont("Helvetica", 13)
    y = 750
    for k, v in info.items():
        c.drawString(70, y, f"{k}: {v}")
        y -= 30
    c.save()
    return filename

